{
  "name": "ultracart-studio",
  "productName": "UltraCart Studio",
  "version": "0.2.0",
  "description": "A local workspace for building and reviewing UltraCart storefront changes with durable agents.",
  "license": "MIT",
  "author": "Scale Lean",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScaleLean/UltraCart-Studio.git"
  },
  "homepage": "https://github.com/ScaleLean/UltraCart-Studio#readme",
  "bugs": {
    "url": "https://github.com/ScaleLean/UltraCart-Studio/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && node scripts/package.mjs --no-archive",
    "package:smoke": "node scripts/package-smoke.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "prettier": "^3.6.2"
  }
}
